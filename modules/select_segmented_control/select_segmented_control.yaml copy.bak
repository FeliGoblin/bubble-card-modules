horizontal_select_buttons:
  name: Select Segmented Control
  version: '1.0'
  creator: FeliGoblin
  supported:
    - select
  description: Test
  code: | 
    .bubble-container {
      overflow: hidden;
      border-radius: ${
        this.config.select_segmented_control?.radius?.card == null
          ? '' : `${this.config.select_segmented_control.radius.card}px !important`
      }
    }

    .bubble-wrapper {
      display: none;
    }

    .ssc-button-container { 
      display: flex;
      justify-content: space-evenly;
      position: relative;
      height: 100%;
      z-index: 5;
    } 

    .ssc-button {
      flex-grow: 1;
      opacity: 0.6;
      line-height: calc(var(--row-height, 56px) * var(--row-size, 1));
      font-size: var(--ha-font-size-m);
      font-weight: bold;
      text-transform: ${
        this.config.select_segmented_control?.text_transform == null ? 'none' 
        : this.config.select_segmented_control.text_transform 
      };
      text-align: center;
      cursor: pointer;
    }

    .ssc-button[selected],
    .ssc-button[selected] ha-icon {
      opacity: 1;
    }

    .ssc-button:hover {
      background: 
        color-mix(
          in oklab, 
          var(--md-ripple-hover-color, 
            var(--ha-ripple-hover-color, 
              var(--ha-ripple-color,
                var(--secondary-text-color)
              )
            )
          ) 3%, 
          transparent
        );
    }

    .bubble-icon {
      width: var(--mdc-icon-size, 24px);
      display: inline-block;
    }

    .ssc-pill {
      background: var(--bubble-button-accent-color, var(--bubble-accent-color, var(--bubble-default-color)));
      height: 100%;
      position: absolute;
      top: 0px;
      transition: none;
      z-index: 0;
    }

    .ssc-button, .ssc-pill {
      border-radius: ${
        this.config.select_segmented_control?.radius?.button == null
          ? 'var(--bubble-border-radius, calc(var(--row-height, 56px) * var(--row-size, 1) / 2))'
          : `${this.config.select_segmented_control.radius.button}px`
      }
    }

    ${(() => { 
      const defaultAnimSpeed = 0.2;

      const moduleID = 'select_segmented_control';
      const config = this.config[moduleID] || {};
      const options = hass.states[entity].attributes?.options ?? [];
      const cardContainer = card.querySelector('.bubble-select-container') ?? null;

      if (!entity || !cardContainer) return;
      if (!options.length) {
        console.warn("Empty options list.");
        return;
      }

      cardContainer.querySelector('.bubble-select')?.remove()
      cardContainer.querySelector('.bubble-dropdown-inner-border')?.remove()

      const selectedIndex = options.indexOf(state);
      const customs = config.button_options ?? null;
      const animSpeed = (config.animation_speed ?? defaultAnimSpeed) + 's';

      var buttonContainer = card.querySelector('.ssc-button-container') ?? null;
      if (!buttonContainer) {
        buttonContainer = document.createElement('div');    
        buttonContainer.classList.add('ssc-button-container');
        cardContainer.appendChild(buttonContainer);
      }
      if (buttonContainer.children?.length != options.length) createButtons();  

      const selectedButton = buttonContainer.children[selectedIndex] ?? null;

      var pill = card.querySelector('.ssc-pill') ?? null;
      if (!pill) {
        pill = document.createElement('div', );
        pill.style.transition = 'none';
        pill.classList.add('ssc-pill');
        pill.style.left = selectedButton.offsetLeft + 'px';
        pill.style.width = selectedButton.offsetWidth + 'px';
        cardContainer.appendChild(pill);
      }

      if (!selectedButton.hasAttribute('selected')) stateChanged();

      const resizeObserver = new ResizeObserver(() => {
        pill.style.left = selectedButton.offsetLeft + 'px';
        pill.style.width = selectedButton.offsetWidth + 'px';
      });
      resizeObserver.observe(selectedButton);

      function createButtons() {
        buttonContainer.innerHTML = "";
        options.forEach((option, index) => {        
          var button = document.createElement('div');
          button.toggleAttribute('selected', index === selectedIndex);
          button.classList.add('ssc-button');
          button.addEventListener('click', (event) => {
            hass.callService('input_select', 'select_option', {entity_id: entity, option: option});
            if (hass.vibrate) navigator.vibrate(20);
          });

          if (customs) {
            var custom_values = customs.find(custom_values => custom_values.index === index + 1);

            if (custom_values) {
              custom_values.tap_action?.forEach((tap_action, index) => {
                button.addEventListener('click', (event) => {
                  var action = tap_action.action?.split(".", 2);            
                  hass.callService(action[0], action[1], {...tap_action.target, ...tap_action.data});
                });
              });
      
              var icon = custom_values.icon ?? null
              
              if (icon) {
                var haIcon = document.createElement('ha-icon');
                haIcon.classList.add('bubble-main-icon', 'bubble-icon', 'icon');
                haIcon.setAttribute('icon', icon);
                haIcon.style.cssText = 'color: inherit; display: inline-block;'

                button.appendChild(haIcon);
                button.setAttribute('icon', icon)
                button.setAttribute('icon_on', custom_values.icon_on ?? "");
              }
              button.append(' ' + (custom_values?.name ?? option));
            } else {
              button.append(option);
            }
          } else {
            button.append(option);
          }
      
          buttonContainer.appendChild(button);
        });
      }

      function stateChanged() {
        pill.style.transition = `left ${animSpeed}, width ${animSpeed}`;

        var from = buttonContainer.querySelector('[selected]')
        if (from) {
            from.removeAttribute('selected');
            if (from.hasAttribute('icon')) {
                from.firstChild.setAttribute('icon', from.attributes.icon.value);
            }
        }

        selectedButton.setAttribute('selected', '');
        var iconOn = selectedButton.attributes?.icon_on?.value;
        if (iconOn) selectedButton.firstChild.setAttribute('icon', iconOn);
      }
    })()} 

editor:
  - name: text_transform
    label: Text Transform
    selector:
      select:
        options:
          - label: Capitalize
            value: capitalize
          - label: Uppercase
            value: uppercase
          - label: Lowercase
            value: lowercase
        multiple: false
        custom_value: false
        mode: dropdown
  - name: button_border_radius
    label: Button Border Radius
    selector:
      number:
        min: 0
        max: 100
        step: 1
        unit_of_measurement: '%'
    default: 100
    required: true
  - name: animation_speed
    label: Animation Speed
    selector:
      number:
        min: 0
        max: 2
        step: 0.1
        unit_of_measurement: s
    default: 0.2
    required: true
  - name: button_options
    label: Button Customizations
    selector:
      object:
        fields:
          index:
            label: Button Number
            required: true
            description: 1 = first button, 2 = second button, 3 = third, etc.
            selector:
              number:
                min: 1
                max: 50
                step: 1
                mode: box
          name:
            label: Name
            description: Enter a single space to hide the name.
            selector:
              text: {}
          icon:
            label: Icon
            selector:
              icon: {}
          icon_on:
            label: Selected Icon
            description: Show a different icon when selected.
            selector:
              icon: {}
        label_field: index
        description_field: name
        multiple: true
